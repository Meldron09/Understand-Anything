#!/bin/sh
# verify-html <file.html> [preflight.md]: tier-0 checks for a self-contained HTML lesson artifact
# (docs/spec/shared.md). Prints one line per violation; exit 1 on any. POSIX sh.
# Rules: no http(s) URL in src/href/url(), balanced <script> tags, every getElementById target
# exists, and the runtime's data-ready marker is in the source. If preflight.md has a line
# `chromium: <command>` (not `none`), also dumps the DOM and requires data-ready on <body>;
# otherwise the caller adds `not browser-tested` to the footer notes.
f=${1:?usage: verify-html <file.html> [preflight.md]}
[ -f "$f" ] || { echo "$f: no such file"; exit 1; }
rc=0
fail() { printf '%s: %s\n' "$f" "$1"; rc=1; }

grep -Eiq "(src|href)[[:space:]]*=[[:space:]]*[\"']?https?://|url\([[:space:]]*[\"']?https?://" "$f" \
  && fail "external URL (src, href or url() must not use http:// or https://)"

open=$(grep -oi '<script' "$f" | wc -l | tr -d ' ')
close=$(grep -oi '</script>' "$f" | wc -l | tr -d ' ')
[ "$open" -eq "$close" ] || fail "unbalanced script tags ($open open, $close close)"

for id in $(grep -o "getElementById([\"'][^\"']*[\"'])" "$f" | sed "s/getElementById([\"']//; s/[\"'])\$//" | sort -u); do
  grep -Eq "id[[:space:]]*=[[:space:]]*[\"']$id[\"']" "$f" || fail "getElementById target missing: $id"
done

grep -q 'data-ready' "$f" || fail "ready marker missing (runtime must set data-ready)"

if [ "$rc" -eq 0 ] && [ -n "$2" ] && [ -f "$2" ]; then
  chrome=$(sed -n 's/^chromium:[[:space:]]*//p' "$2" | head -n 1)
  if [ -n "$chrome" ] && [ "$chrome" != none ]; then
    abs=$(cd "$(dirname "$f")" && pwd)/$(basename "$f")
    "$chrome" --headless --disable-gpu --dump-dom "file://$abs" 2>/dev/null | grep -q '<body[^>]*data-ready' \
      || fail "browser: data-ready not set on <body> after load"
  fi
fi
exit "$rc"
