#!/bin/sh
# assemble <work-dir> <out.mp4> [--preflight <preflight.md>] [--script <narration-script.md>]
# Normalise every clip to its measured duration D (trim or hold the last frame), add its narration,
# concatenate, write sentence-level <out>.srt from D (proportional to words inside a scene), and add
# a soft mov_text track when preflight.md says `subtitles filter: true` (else sidecar only; no burn-in).
# With voice none (no audio) it also writes the narration script. Needs <work>/timing.json, clips/sNN.mp4,
# narration/sNN.txt, audio/sNN.wav (unless voice none). Prints `scenes=<n> seconds=<n> captions=soft|sidecar
# narration=<voice>`. Exit 1 on a missing clip, 4 without ffmpeg.
w=${1:?usage: assemble <work-dir> <out.mp4> [--preflight f] [--script f]} out=${2:?out.mp4}; shift 2
pf=; script=
while [ $# -gt 0 ]; do case $1 in --preflight) pf=$2; shift 2;; --script) script=$2; shift 2;; *) shift;; esac; done
command -v ffmpeg >/dev/null 2>&1 || { echo "assemble: ffmpeg missing"; exit 4; }
t=$w/timing.json
pairs=$(sed -n 's/.*"id":"\(s[0-9][0-9]*\)","seconds":\([0-9.][0-9.]*\).*/\1 \2/p' "$t")
voice=$(sed -n 's/.*"voice":"\([a-z]*\)".*/\1/p' "$t" | head -n 1)
[ -n "$pairs" ] || { echo "assemble: no scenes in $t"; exit 1; }

mkdir -p "$w/parts"; : > "$w/parts/list.txt"
n=0; total=0
while read -r id d; do
  [ -s "$w/clips/$id.mp4" ] || { echo "assemble: missing clip $id"; exit 1; }
  if [ "$voice" = none ]; then
    ffmpeg -y -loglevel error -i "$w/clips/$id.mp4" -vf "scale=1280:720,fps=30,tpad=stop_mode=clone:stop_duration=$d" \
      -t "$d" -c:v libx264 -pix_fmt yuv420p -an "$w/parts/$id.mp4" || exit 1
  else
    ffmpeg -y -loglevel error -i "$w/clips/$id.mp4" -i "$w/audio/$id.wav" -map 0:v -map 1:a \
      -vf "scale=1280:720,fps=30,tpad=stop_mode=clone:stop_duration=$d" -af "apad=whole_dur=$d" \
      -t "$d" -c:v libx264 -pix_fmt yuv420p -c:a aac -ar 44100 -ac 2 "$w/parts/$id.mp4" || exit 1
  fi
  echo "file '$id.mp4'" >> "$w/parts/list.txt"
  n=$((n + 1)); total=$(awk -v a="$total" -v b="$d" 'BEGIN { print a + b }')
done <<EOF
$pairs
EOF

srt=${out%.mp4}.srt
printf '%s\n' "$pairs" | awk -v dir="$w/narration" '
  function ts(t,  ms, h, m, s) {
    ms = int(t * 1000 + 0.5); h = int(ms / 3600000); ms -= h * 3600000
    m = int(ms / 60000); ms -= m * 60000; s = int(ms / 1000); ms -= s * 1000
    return sprintf("%02d:%02d:%02d,%03d", h, m, s, ms)
  }
  {
    id = $1; d = $2; txt = ""; f = dir "/" id ".txt"
    while ((getline line < f) > 0) txt = txt (txt == "" ? "" : " ") line
    close(f)
    gsub(/[.!?]+[ \t]+/, "&\n", txt)
    k = split(txt, sent, "\n"); words = 0
    for (i = 1; i <= k; i++) {
      sub(/^[ \t]+/, "", sent[i]); sub(/[ \t]+$/, "", sent[i])
      cnt[i] = (sent[i] == "") ? 0 : split(sent[i], tmp, /[ \t]+/); words += cnt[i]
    }
    s = off
    for (i = 1; i <= k && words > 0; i++) {
      if (!cnt[i]) continue
      e = s + d * cnt[i] / words
      printf "%d\n%s --> %s\n%s\n\n", ++c, ts(s), ts(e), sent[i]; s = e
    }
    off += d
  }' > "$srt"

caps=sidecar
if [ -n "$pf" ] && grep -q 'subtitles filter: true' "$pf" 2>/dev/null; then
  ffmpeg -y -loglevel error -f concat -safe 0 -i "$w/parts/list.txt" -c copy "$w/parts/joined.mp4" &&
    ffmpeg -y -loglevel error -i "$w/parts/joined.mp4" -i "$srt" -c copy -c:s mov_text "$out" && caps=soft || exit 1
else
  ffmpeg -y -loglevel error -f concat -safe 0 -i "$w/parts/list.txt" -c copy "$out" || exit 1
fi

if [ "$voice" = none ] && [ -n "$script" ]; then
  { echo "# Narration script"; echo
    for f in "$w"/narration/s*.txt; do echo "## $(basename "$f" .txt)"; echo; cat "$f"; echo; done; } > "$script"
fi
echo "scenes=$n seconds=$(awk -v a="$total" 'BEGIN { printf "%d", a + 0.5 }') captions=$caps narration=$voice"
